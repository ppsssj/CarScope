<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only WebGL experiment, read-only identity diagnostic and visual-profile screen. Exported for adb on the
     test AVD; none of these activities has a launcher entry or exists in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- P3-V1 read-only Tire probe only; these permissions never enter the release manifest. -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <application>
        <activity android:name=".sync.SyncReceiverActivity" android:exported="true" android:label="CarScope 점검 수신 (debug)" />
        <activity android:name=".tire.TireProbeActivity" android:exported="true" android:label="CarScope Tire API probe (debug)" />
        <uses-library android:name="android.car" android:required="false" />
        <activity
            android:name=".identity.VehicleIdentityActivity"
            android:exported="true"
            android:label="CarScope identity probe" />
        <!-- P2-A8: main screen with an explicit visual profile; reads only app-private debug files. -->
        <activity
            android:name=".profile.VisualProfileActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="CarScope visual profile (debug)" />
        <activity
            android:name=".lab.WebGlLabActivity"
            android:exported="true"
            android:label="CarScope WebGL lab" />
        <!-- P3-A5.1: IONIQ 5 Three.js rendering feasibility; the GLB is read from app-private debug storage. -->
        <activity
            android:name=".lab.Ioniq5LabActivity"
            android:exported="true"
            android:label="CarScope IONIQ 5 WebGL lab" />
        <!-- P3-A5.2: the P3-A4 inspection flow in a debug WebView; same hosting and model file as the lab. -->
        <activity
            android:name=".lab.InspectionActivity"
            android:exported="true"
            android:label="CarScope inspection (debug)" />
    </application>
</manifest>
