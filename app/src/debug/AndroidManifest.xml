<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only WebGL experiment and read-only identity diagnostic. Exported for adb on the
     test AVD; neither activity has a launcher entry or exists in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <application>
        <uses-library android:name="android.car" android:required="false" />
        <activity
            android:name=".identity.VehicleIdentityActivity"
            android:exported="true"
            android:label="CarScope identity probe" />
        <activity
            android:name=".lab.WebGlLabActivity"
            android:exported="true"
            android:label="CarScope WebGL lab" />
    </application>
</manifest>
